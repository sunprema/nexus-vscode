{
  "name": "nexus-explainer",
  "displayName": "Nexus Explainer",
  "description": "View Project Nexus's explainer-branch narrative for the file you're editing \u2014 a CodeLens at the top of the file, split-screen, without leaving VS Code.",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "sunprema",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunprema/nexus-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension-node.js",
  "browser": "./dist/extension-web.js",
  "contributes": {
    "commands": [
      {
        "command": "nexus.showExplainer",
        "title": "Nexus: Show Explainer",
        "category": "Nexus"
      },
      {
        "command": "nexus.refreshCodeLenses",
        "title": "Nexus: Refresh Explainer Status",
        "category": "Nexus"
      },
      {
        "command": "nexus.showExplainerDiff",
        "title": "Nexus: Show Explainer Diff",
        "category": "Nexus"
      },
      {
        "command": "nexus.startTour",
        "title": "Nexus: Start Tour",
        "category": "Nexus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nexus.showExplainer",
          "group": "navigation"
        },
        {
          "command": "nexus.showExplainerDiff",
          "group": "navigation",
          "when": "!isWeb"
        }
      ],
      "explorer/context": [
        {
          "command": "nexus.showExplainer",
          "group": "navigation",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "nexus.showExplainerDiff",
          "group": "navigation",
          "when": "!explorerResourceIsFolder && !isWeb"
        }
      ],
      "commandPalette": [
        {
          "command": "nexus.showExplainer"
        },
        {
          "command": "nexus.refreshCodeLenses"
        },
        {
          "command": "nexus.showExplainerDiff",
          "when": "!isWeb"
        },
        {
          "command": "nexus.startTour"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nexus.showExplainer",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "nexus.showExplainer",
        "key": "x",
        "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsFolder"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "watch:tsc": "tsc -watch -p ./",
    "test": "npm run compile && npm run bundle && node --test \"out/test/*.test.js\"",
    "test:web": "npm run bundle && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. https://github.com/sunprema/nexus-cli",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "js-yaml": "^5.4.1"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
