{
  "name": "nexus-explainer",
  "displayName": "Nexus Explainer",
  "description": "View Project Nexus's explainer-branch narrative for the file you're editing, split-screen, without leaving VS Code.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nexus.showExplainer",
        "title": "Nexus: Show Explainer",
        "category": "Nexus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nexus.showExplainer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nexus.showExplainer"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nexus.showExplainer",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
